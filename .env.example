# ── Persistence ────────────────────────────────────────────────────────
# SQLite is the default and needs no external service. Set neo4j to retain
# compatibility graph routes on a Neo4j deployment.
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/blaze.sqlite3

# ── Neo4j Database (optional compatibility backend) ────────────────────
# URI for the Neo4j Bolt connection
NEO4J_URI=bolt://localhost:7687
# Neo4j username
NEO4J_USER=neo4j
# Neo4j password
NEO4J_PASSWORD=burner_social_dev

# ── JWT Authentication ─────────────────────────────────────────────────
# Secret key used to sign and verify JWT tokens
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=blaze-dev-secret-change-in-production

# ── API Server ─────────────────────────────────────────────────────────
# Host to bind the API server
HOST=0.0.0.0
# Port to bind the API server
PORT=8000

# ── Frontend ───────────────────────────────────────────────────────────
# Base URL of the backend API (used by the Vite dev server proxy)
VITE_API_BASE_URL=http://localhost:8000
